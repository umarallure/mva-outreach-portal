NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secrets. Never expose these through NEXT_PUBLIC_* variables.
GOLOGIN_API_TOKEN=
OUTREACH_SESSION_ENCRYPTION_KEY=
OUTREACH_SESSION_STALE_MINUTES=120

# Calendly scheduling ingestion.
CALENDLY_WEBHOOK_SIGNING_KEY=
CRON_SECRET=
CALENDLY_BACKFILL_LOOKBACK_DAYS=90
# Past-day window the hourly cron reconciles (future bookings are always covered). Defaults to 2.
CALENDLY_CRON_LOOKBACK_DAYS=2
CALENDLY_INSURANCE_API_TOKEN=
CALENDLY_INSURANCE_USER_URI=
CALENDLY_INSURANCE_ORGANIZATION_URI=
CALENDLY_MVA_API_TOKEN=
CALENDLY_MVA_USER_URI=
CALENDLY_MVA_ORGANIZATION_URI=

# Embedded live cloud browser (see gateway/ and src/lib/cdp-screencast.ts).
# Public wss:// URL of the browser-gateway service (always-on host, NOT Vercel).
NEXT_PUBLIC_BROWSER_GATEWAY_URL=
# Shared secret used to sign short-lived viewer tickets. MUST match the gateway's
# RELAY_JWT_SECRET. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RELAY_JWT_SECRET=

DEFAULT_TARGET_URL_PUBLISHER_KELLER=
