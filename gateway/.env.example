# --- Browser-gateway environment ---
# GoLogin developer token (Bearer). Lives ONLY here and on the Vercel server.
GOLOGIN_API_TOKEN=

# Shared secret with the Next app's viewer-ticket signer (must match the portal's RELAY_JWT_SECRET).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RELAY_JWT_SECRET=

# Port to listen on (Fly/Railway/Render usually inject PORT automatically).
PORT=8787

# Comma-separated allowlist of browser origins permitted to connect.
# Leave empty in local dev; set to your portal origin(s) in production, e.g.:
# ALLOWED_ORIGIN=https://portal.example.com
ALLOWED_ORIGIN=

# Upstream GoLogin CDP connect endpoint (rarely needs changing).
GOLOGIN_CONNECT_URL=wss://cloudbrowser.gologin.com/connect

# Relay lifecycle guards (milliseconds).
KEEPALIVE_MS=30000
MAX_SESSION_MS=14400000
